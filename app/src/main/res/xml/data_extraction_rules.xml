<?xml version="1.0" encoding="utf-8"?>
<!-- Progress and settings live in DataStore files: back them up and restore them. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
