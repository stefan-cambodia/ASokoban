    <string name="hint_w1_02">Walk around a crate to push it in a new direction.</string>
    <string name="level_w1_03">Pair</string>
    <string name="hint_w1_03">Every crate needs a target of its own.</string>
    <string name="level_w1_04">Along the Wall</string>
    <string name="hint_w1_04">Against a wall, a crate can only slide along it. Stuck? Tap Undo.</string>
    <string name="level_w1_05">Doorway</string>
    <string name="hint_w1_05">Crates fit through narrow gaps — line them up first.</string>
    <string name="level_w1_06">Far End First</string>
    <string name="hint_w1_06">Fill the deepest target first, or the way gets blocked.</string>
    <string name="level_w1_07">One at a Time</string>
    <string name="hint_w1_07">You can only push one crate at a time.</string>
    <string name="level_w1_08">Three</string>
    <string name="hint_w1_08">Plan which crate goes where before you push.</string>
    <string name="level_w1_09">Corners</string>
    <string name="hint_w1_09">A crate pushed into a corner can never leave it.</string>
